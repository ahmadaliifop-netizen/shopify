<div class="announcement-bar" {% if section.settings.enable_rotation and section.blocks.size > 1 %}data-rotate="{{ section.settings.rotate_speed | times: 1000 }}"{% endif %}>
  <div class="announcement-bar__track" data-announcement-track>
    {%- for block in section.blocks -%}
      <p class="announcement-bar__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
        {%- else -%}
          {{ block.settings.text }}
        {%- endif -%}
      </p>
    {%- else -%}
      {%- capture threshold_amount -%}${{ settings.free_shipping_threshold }}{%- endcapture -%}
      <p class="announcement-bar__item is-active">{{ 'header.announcement_default' | t: amount: threshold_amount }}</p>
    {%- endfor -%}
  </div>
</div>

{% if section.settings.enable_rotation and section.blocks.size > 1 %}
<script>
  (function () {
    var track = document.currentScript.previousElementSibling.querySelector('[data-announcement-track]') || document.querySelector('[data-announcement-track]');
    var bar = document.currentScript.closest('.announcement-bar') || document.querySelector('.announcement-bar');
    if (!bar) return;
    var items = bar.querySelectorAll('.announcement-bar__item');
    var i = 0;
    setInterval(function () {
      items[i].classList.remove('is-active');
      i = (i + 1) % items.length;
      items[i].classList.add('is-active');
    }, parseInt(bar.getAttribute('data-rotate'), 10) || 5000);
  })();
</script>
{% endif %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_rotation",
      "label": "Rotate messages",
      "default": true
    },
    {
      "type": "number",
      "id": "rotate_speed",
      "label": "Rotate every (seconds)",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free delivery on orders over $75" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "message", "settings": { "text": "Free delivery on orders over $75" } },
      { "type": "message", "settings": { "text": "New arrivals — the everyday edit" } },
      { "type": "message", "settings": { "text": "A considered ritual, delivered" } }
    ]
  }
}
{% endschema %}
