<div class="section section--tight">
  <div class="container">
    <div class="section-head" data-reveal>
      <div class="section-head__text">
        <p class="eyebrow">{{ section.settings.eyebrow | default: "Journal" }}</p>
        <h2>{{ section.settings.heading | default: "Notes on skin & self-care" }}</h2>
      </div>
      {%- if section.settings.blog != blank -%}
        <a href="{{ section.settings.blog.url }}" class="text-link">{{ 'header.view_all' | t }} {% render 'icon', name: 'arrow-right' %}</a>
      {%- endif -%}
    </div>
    <div class="grid grid--3">
      {%- for article in section.settings.blog.articles limit: 3 -%}
        <a href="{{ article.url }}" class="article-card" data-reveal>
          <div class="media media--landscape media--zoom">
            {%- if article.image != blank -%}
              <img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.image.alt | escape }}" loading="lazy" width="800" height="600">
            {%- else -%}
              <div class="media__placeholder">{% render 'icon', name: 'image', size: 36 %}</div>
            {%- endif -%}
          </div>
          <p class="article-card__meta">{{ article.published_at | date: '%B %d, %Y' }}</p>
          <h3 class="h4 article-card__title">{{ article.title }}</h3>
        </a>
      {%- else -%}
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.link }}" class="article-card" data-reveal {{ block.shopify_attributes }}>
            <div class="media media--landscape media--zoom">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 800 }}" alt="" loading="lazy" width="800" height="600">
              {%- else -%}
                <div class="media__placeholder">{% render 'icon', name: 'image', size: 36 %}</div>
              {%- endif -%}
            </div>
            <p class="article-card__meta">{{ block.settings.date }}</p>
            <h3 class="h4 article-card__title">{{ block.settings.title }}</h3>
          </a>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Journal teaser",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Notes on skin & self-care" },
    { "type": "blog", "id": "blog", "label": "Blog" }
  ],
  "blocks": [
    {
      "type": "article",
      "name": "Article (fallback)",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Reading your skin: a beginner's guide" },
        { "type": "text", "id": "date", "label": "Date label", "default": "Ingredient notes" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "article", "settings": { "title": "Reading your skin: a beginner's guide", "date": "Ingredient notes" } },
      { "type": "article", "settings": { "title": "The case for a slower routine", "date": "Rituals" } },
      { "type": "article", "settings": { "title": "What 'clean beauty' actually means", "date": "Ingredient notes" } }
    ]
  },
  "presets": [{ "name": "Journal teaser" }]
}
{% endschema %}
