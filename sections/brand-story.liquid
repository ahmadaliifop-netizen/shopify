<div class="section{% if section.settings.background == 'alt' %} section--alt{% elsif section.settings.background == 'ink' %} section--ink{% endif %}">
  <div class="container">
    <div class="split{% if section.settings.image_position == 'right' %} split--reverse{% endif %}" data-reveal>
      <div class="split__media">
        <div class="media media--landscape">
          {%- if section.settings.image != blank -%}
            <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy" width="1200" height="900">
          {%- else -%}
            <div class="media__placeholder">{% render 'icon', name: 'image', size: 48 %}</div>
          {%- endif -%}
        </div>
      </div>
      <div class="split__text">
        <p class="eyebrow{% if section.settings.background == 'ink' %} eyebrow--on-dark{% endif %}">{{ section.settings.eyebrow | default: "Our philosophy" }}</p>
        <h2>{{ section.settings.heading | default: "Considered self-care, made simple." }}</h2>
        <p class="text-lede" {% if section.settings.background == 'ink' %}style="color: rgba(247,244,237,0.75);"{% endif %}>
          {{ section.settings.body | default: "SANAYA is a calm edit of skincare, beauty and wellness — nothing you don't need, everything that makes the everyday feel considered." }}
        </p>
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="btn {% if section.settings.background == 'ink' %}btn--on-ink{% else %}btn--secondary{% endif %}">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Brand story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our philosophy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Considered self-care, made simple." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "SANAYA is a calm edit of skincare, beauty and wellness — nothing you don't need, everything that makes the everyday feel considered." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Our story" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "alt",
      "options": [
        { "value": "default", "label": "Cream" },
        { "value": "alt", "label": "Soft cream" },
        { "value": "ink", "label": "Teal" }
      ]
    }
  ],
  "presets": [{ "name": "Brand story" }]
}
{% endschema %}
