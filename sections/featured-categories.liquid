<div class="section{% if section.settings.background == 'alt' %} section--alt{% endif %}">
  <div class="container">
    <div class="section-head" data-reveal>
      <div class="section-head__text">
        <p class="eyebrow">{{ section.settings.eyebrow | default: "Shop by category" }}</p>
        <h2>{{ section.settings.heading | default: "A calm edit, by ritual." }}</h2>
      </div>
    </div>
    <div class="grid grid--3">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link }}" class="category-card" data-reveal {{ block.shopify_attributes }}>
          <div class="media media--portrait media--zoom">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="800" height="1000">
            {%- else -%}
              <div class="media__placeholder">{% render 'icon', name: 'image', size: 40 %}</div>
            {%- endif -%}
          </div>
          <div class="category-card__label">
            <h3 class="h3" style="font-size:22px;">{{ block.settings.title }}</h3>
            <span class="text-link">{{ 'header.explore' | t }} {% render 'icon', name: 'arrow-right' %}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Featured categories",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by category" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A calm edit, by ritual." },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "default",
      "options": [
        { "value": "default", "label": "Cream" },
        { "value": "alt", "label": "Soft cream" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Skincare" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "category", "settings": { "title": "Skincare" } },
      { "type": "category", "settings": { "title": "Beauty" } },
      { "type": "category", "settings": { "title": "Wellness" } }
    ]
  },
  "presets": [{ "name": "Featured categories" }]
}
{% endschema %}
