<div class="page-hero container">
  <p class="eyebrow">{{ section.settings.eyebrow | default: "About SANAYA" }}</p>
  <h1 class="h1" style="max-width: 16ch; margin-inline: auto;">{{ section.settings.heading | default: "Self-care, simplified." }}</h1>
  <p class="text-lede prose">{{ section.settings.intro | default: "SANAYA is a calm edit of skincare, beauty and wellness — nothing you don't need, everything that makes the everyday feel considered." }}</p>
</div>

<div class="container">
  <div class="media media--wide" data-reveal>
    {%- if section.settings.hero_image != blank -%}
      <img src="{{ section.settings.hero_image | image_url: width: 1800 }}" alt="" loading="lazy" width="1800" height="1013">
    {%- else -%}
      <div class="media__placeholder">{% render 'icon', name: 'image', size: 56 %}</div>
    {%- endif -%}
  </div>
</div>

<div class="section">
  <div class="container">
    <div class="split" data-reveal>
      <div class="split__media">
        <div class="media media--portrait">
          {%- if section.settings.mission_image != blank -%}
            <img src="{{ section.settings.mission_image | image_url: width: 1000 }}" alt="" loading="lazy" width="1000" height="1250">
          {%- else -%}
            <div class="media__placeholder">{% render 'icon', name: 'image', size: 48 %}</div>
          {%- endif -%}
        </div>
      </div>
      <div class="split__text">
        <p class="eyebrow">Our mission</p>
        <h2>{{ section.settings.mission_heading | default: "Considered, not complicated." }}</h2>
        <p class="text-lede">{{ section.settings.mission_body | default: "We believe self-care shouldn't be another chore. Every SANAYA product is chosen for what it leaves out as much as what it includes — quietly effective, gently formulated, made to become a ritual rather than a routine." }}</p>
      </div>
    </div>
  </div>
</div>

<div class="section section--alt">
  <div class="container">
    <div class="section-head" data-reveal>
      <div class="section-head__text">
        <p class="eyebrow">What we stand for</p>
        <h2>Our values</h2>
      </div>
    </div>
    <div class="grid grid--3 values-grid">
      {%- for block in section.blocks -%}
        <div data-reveal {{ block.shopify_attributes }}>
          {% render 'icon', name: block.settings.icon, size: 24 %}
          <h3 class="h4">{{ block.settings.title }}</h3>
          <p class="text-muted">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<div class="section">
  <div class="container">
    <div class="split split--reverse" data-reveal>
      <div class="split__media">
        <div class="media media--portrait">
          {%- if section.settings.founder_image != blank -%}
            <img src="{{ section.settings.founder_image | image_url: width: 1000 }}" alt="" loading="lazy" width="1000" height="1250">
          {%- else -%}
            <div class="media__placeholder">{% render 'icon', name: 'image', size: 48 %}</div>
          {%- endif -%}
        </div>
      </div>
      <div class="split__text">
        <p class="eyebrow">A note from the founder</p>
        <h2>{{ section.settings.founder_heading | default: "Why SANAYA exists" }}</h2>
        <p class="text-lede">{{ section.settings.founder_body | default: "I wanted a shelf I trusted — a small, honest edit instead of an overwhelming aisle. SANAYA is that edit: the things I reach for daily, and nothing I don't." }}</p>
        <p class="text-muted">{{ section.settings.founder_name | default: "— Founder, SANAYA" }}</p>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "About SANAYA" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Self-care, simplified." },
    { "type": "textarea", "id": "intro", "label": "Intro" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "image_picker", "id": "mission_image", "label": "Mission image" },
    { "type": "text", "id": "mission_heading", "label": "Mission heading", "default": "Considered, not complicated." },
    { "type": "textarea", "id": "mission_body", "label": "Mission body" },
    { "type": "image_picker", "id": "founder_image", "label": "Founder image" },
    { "type": "text", "id": "founder_heading", "label": "Founder heading", "default": "Why SANAYA exists" },
    { "type": "textarea", "id": "founder_body", "label": "Founder body" },
    { "type": "text", "id": "founder_name", "label": "Founder credit", "default": "— Founder, SANAYA" }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "leaf",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "shield", "label": "Shield" },
            { "value": "heart", "label": "Heart" },
            { "value": "sparkle", "label": "Sparkle" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Clean by default" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Formulated without the ingredients we'd rather leave out." }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "value", "settings": { "icon": "leaf", "title": "Clean by default", "text": "Formulated without the ingredients we'd rather leave out." } },
      { "type": "value", "settings": { "icon": "heart", "title": "Cruelty-free, always", "text": "Never tested on animals, at any stage." } },
      { "type": "value", "settings": { "icon": "sparkle", "title": "Considered, not curated for hype", "text": "A small edit that earns its place on your shelf." } }
    ]
  }
}
{% endschema %}
