<div class="page-hero container">
  <p class="eyebrow">{{ 'header.journal' | t }}</p>
  <h1 class="h1">{{ blog.title }}</h1>
</div>
<div class="container section section--tight">
  {%- paginate blog.articles by 12 -%}
    <div class="grid grid--3">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="article-card" data-reveal>
          <div class="media media--landscape media--zoom">
            {%- if article.image -%}
              <img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.image.alt | escape }}" loading="lazy" width="800" height="600">
            {%- else -%}
              <div class="media__placeholder">{% render 'icon', name: 'image', size: 36 %}</div>
            {%- endif -%}
          </div>
          <p class="article-card__meta">{{ article.published_at | date: '%B %d, %Y' }}</p>
          <h3 class="h4 article-card__title">{{ article.title }}</h3>
        </a>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pagination">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="pagination__arrow pagination__arrow--prev">←</a>{%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span class="is-current">{{ part.title }}</span>{%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="pagination__arrow pagination__arrow--next">→</a>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{ "name": "Blog page", "settings": [] }
{% endschema %}
