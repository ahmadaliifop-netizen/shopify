<div class="page-hero container">
  <p class="eyebrow">{{ section.settings.eyebrow | default: "Get in touch" }}</p>
  <h1 class="h1">{{ section.settings.heading | default: "We'd love to hear from you." }}</h1>
  <p class="text-lede prose">{{ section.settings.intro | default: "Questions about a product, an order, or just want to say hello — send a note and we'll reply within one business day." }}</p>
</div>

<div class="section section--tight">
  <div class="container">
    <div class="split">
      <div class="split__text form-page" style="margin:0;">
        {%- form 'contact', class: 'contact-form' -%}
          {%- if form.posted_successfully? -%}
            <p class="field-group" style="color: var(--color-ink); background: var(--color-bg-alt); padding: 16px; border-radius: var(--radius-md);">{{ 'contact.form.success' | t }}</p>
          {%- endif -%}
          <div class="field-group">
            <label class="field-label" for="ContactName">{{ 'contact.form.name' | t }}</label>
            <input class="field" type="text" id="ContactName" name="contact[name]" required>
          </div>
          <div class="field-group">
            <label class="field-label" for="ContactEmail">{{ 'contact.form.email' | t }}</label>
            <input class="field" type="email" id="ContactEmail" name="contact[email]" value="{{ form.email }}" required>
          </div>
          <div class="field-group">
            <label class="field-label" for="ContactMessage">{{ 'contact.form.message' | t }}</label>
            <textarea class="field" id="ContactMessage" name="contact[body]" required>{{ form.body }}</textarea>
          </div>
          <button type="submit" class="btn btn--primary btn--full">{{ 'contact.form.submit' | t }}</button>
        {%- endform -%}
      </div>
      <div class="split__text">
        <p class="eyebrow">Details</p>
        <h3>Reach us directly</h3>
        <p class="text-muted">{{ shop.email }}</p>
        {%- if section.settings.phone != blank -%}<p class="text-muted">{{ section.settings.phone }}</p>{%- endif -%}
        {%- if section.settings.address != blank -%}<p class="text-muted">{{ section.settings.address }}</p>{%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Get in touch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We'd love to hear from you." },
    { "type": "textarea", "id": "intro", "label": "Intro" },
    { "type": "text", "id": "phone", "label": "Phone" },
    { "type": "text", "id": "address", "label": "Address" }
  ]
}
{% endschema %}
