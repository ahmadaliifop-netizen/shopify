<div class="page-hero container">
  <p class="eyebrow">{{ section.settings.eyebrow | default: "Page" }}</p>
  <h1 class="h1">{{ page.title }}</h1>
</div>
<div class="container section section--tight">
  <div class="prose">{{ page.content }}</div>
</div>

{% schema %}
{
  "name": "Page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Page" }
  ]
}
{% endschema %}
