<div class="section section--tight{% if section.settings.background == 'alt' %} section--alt{% endif %}">
  <div class="container">
    <div class="section-head" data-reveal>
      <div class="section-head__text">
        <p class="eyebrow">{{ section.settings.eyebrow | default: "Bestsellers" }}</p>
        <h2>{{ section.settings.heading | default: "The everyday edit" }}</h2>
      </div>
      {%- if section.settings.collection != blank -%}
        <a href="{{ section.settings.collection.url }}" class="text-link">{{ 'header.view_all' | t }} {% render 'icon', name: 'arrow-right' %}</a>
      {%- endif -%}
    </div>

    {%- if section.settings.layout == 'grid' -%}
      <div class="grid grid--4">
        {%- for product in section.settings.collection.products limit: section.settings.product_count -%}
          {% render 'product-card', product: product %}
        {%- else -%}
          {%- for i in (1..4) -%}
            <div class="product-card">
              <div class="media media--portrait"><div class="media__placeholder">{% render 'icon', name: 'image', size: 40 %}</div></div>
              <div class="product-card__body">
                <p class="product-card__title">Sample product</p>
                <p class="product-card__price">$28.00</p>
              </div>
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="rail">
        {%- for product in section.settings.collection.products limit: section.settings.product_count -%}
          {% render 'product-card', product: product %}
        {%- else -%}
          {%- for i in (1..4) -%}
            <div class="product-card" style="width:260px;">
              <div class="media media--portrait"><div class="media__placeholder">{% render 'icon', name: 'image', size: 40 %}</div></div>
              <div class="product-card__body">
                <p class="product-card__title">Sample product</p>
                <p class="product-card__price">$28.00</p>
              </div>
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Product rail",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The everyday edit" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "product_count", "label": "Products to show", "min": 4, "max": 12, "step": 1, "default": 8 },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "rail",
      "options": [
        { "value": "rail", "label": "Horizontal scroll" },
        { "value": "grid", "label": "Grid" }
      ]
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "default",
      "options": [
        { "value": "default", "label": "Cream" },
        { "value": "alt", "label": "Soft cream" }
      ]
    }
  ],
  "presets": [{ "name": "Product rail" }]
}
{% endschema %}
