<div class="section section--tight section--alt">
  <div class="container">
    <div class="section-head" style="justify-content:center; text-align:center;" data-reveal>
      <div class="section-head__text" style="margin-inline:auto;">
        <p class="eyebrow">{{ section.settings.eyebrow | default: "In their words" }}</p>
        <h2>{{ section.settings.heading | default: "Quietly loved" }}</h2>
      </div>
    </div>
    <div class="testimonial-slider" data-testimonial-slider data-reveal>
      {%- for block in section.blocks -%}
        <div class="testimonial-slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.rating > 0 -%}
            <div class="testimonial-slide__stars" aria-hidden="true">
              {%- for i in (1..block.settings.rating) -%}{% render 'icon', name: 'star', size: 16 %}{%- endfor -%}
            </div>
          {%- endif -%}
          <blockquote>&ldquo;{{ block.settings.quote }}&rdquo;</blockquote>
          <p class="testimonial-slide__author">{{ block.settings.author }}</p>
        </div>
      {%- endfor -%}
      <div class="testimonial-nav">
        {%- for block in section.blocks -%}
          <button class="testimonial-nav__dot{% if forloop.first %} is-active{% endif %}" aria-label="Show testimonial {{ forloop.index }}"></button>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "In their words" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Quietly loved" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "range", "id": "rating", "label": "Stars", "min": 0, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "The first routine that's actually felt like mine. Simple, effective, and it smells like a spa." },
        { "type": "text", "id": "author", "label": "Author", "default": "Layla H., verified buyer" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "testimonial", "settings": { "quote": "The first routine that's actually felt like mine. Simple, effective, and it smells like a spa.", "author": "Layla H., verified buyer" } },
      { "type": "testimonial", "settings": { "quote": "Skin looks calmer within a week. I don't reach for anything else now.", "author": "Nour A., verified buyer" } },
      { "type": "testimonial", "settings": { "quote": "Considered is the right word. Nothing feels excessive, everything feels intentional.", "author": "Maya S., verified buyer" } }
    ]
  },
  "presets": [{ "name": "Testimonials" }]
}
{% endschema %}
